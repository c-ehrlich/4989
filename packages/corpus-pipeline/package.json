{
  "name": "@4989/corpus-pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src",
    "list-videos": "pnpm build && node ./dist/cli/list-videos.js",
    "discover-scripts": "pnpm build && node ./dist/cli/discover-scripts.js",
    "build-manifest": "pnpm build && node ./dist/cli/build-manifest.js",
    "process-episode": "pnpm build && node ./dist/cli/process-episode.js",
    "rebuild-index": "pnpm build && node ./dist/cli/rebuild-index.js",
    "search": "pnpm build && node ./dist/cli/search.js",
    "validate-alignment": "pnpm build && node ./dist/cli/validate-alignment.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@4989/corpus-types": "workspace:*"
  }
}
